#!/usr/bin/env python3
# AVI pre-commit hook — aborta el commit si la auditoría falla.
# Para saltarlo intencionalmente: git commit --no-verify (solo emergencias)
#
# ESTE es el hook VIVO: core.hooksPath=scripts/hooks (así la copia versionada
# y la activa son EL MISMO archivo; antes .git/hooks divergía en silencio).
# Reescrito 2026-07-06: el hook viejo auditaba el <script> inline de index.html
# y apex-core.js/apex.test.js — todo pre-modularización y pre-rename. Desde
# entonces el JS vive en avi-core.js + app-1..6 + muscle-map + exercise-muscles,
# y encima core.hooksPath apuntaba a Desktop\apex (ruta muerta) → NINGÚN commit
# corría el audit. Ahora audita los módulos reales.

import re, subprocess, sys, os, io, json
from collections import Counter

sys.stdout = io.TextIOWrapper(sys.stdout.buffer, encoding='utf-8', errors='replace')
sys.stderr = io.TextIOWrapper(sys.stderr.buffer, encoding='utf-8', errors='replace')

ROOT = os.path.dirname(os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
INDEX = os.path.join(ROOT, 'index.html')

# Todos los módulos JS que embarca la app (el orden refleja index.html).
APP_JS = ['avi-core.js', 'muscle-map.js', 'exercise-muscles.js', 'app-1-infra.js',
          'app-2-login.js', 'app-3-coach.js', 'app-4-entreno.js', 'app-5-salud.js',
          'app-6-extra.js', 'app-7-community.js']

RED   = '\033[91m'
GREEN = '\033[92m'
YELLOW= '\033[93m'
RESET = '\033[0m'
BOLD  = '\033[1m'

errors = []
warnings = []

def ok(msg):    print(f'  {GREEN}✅{RESET} {msg}')
def fail(msg):  errors.append(msg);  print(f'  {RED}❌{RESET} {msg}')
def warn(msg):  warnings.append(msg);print(f'  {YELLOW}⚠️ {RESET} {msg}')

print(f'\n{BOLD}━━━ AVI pre-commit audit ━━━{RESET}')

if not os.path.exists(INDEX):
    print(f'{YELLOW}⚠️  index.html no encontrado — audit saltado{RESET}\n')
    sys.exit(0)

with open(INDEX, encoding='utf-8') as f:
    src = f.read()

# JS inline de index.html (queda poco, pero sigue siendo código embarcado).
script_start = src.find('<script>')
script_end   = src.find('</script>', script_start)
inline_js  = src[script_start + 8 : script_end] if script_start != -1 else ''

# (etiqueta, contenido) de cada módulo presente.
modules = [('inline', inline_js)]
for name in APP_JS:
    p = os.path.join(ROOT, name)
    if os.path.exists(p):
        with open(p, encoding='utf-8') as f:
            modules.append((name, f.read()))
    else:
        warn(f'{name} no existe — ¿se renombró? Actualiza APP_JS en scripts/hooks/pre-commit')

all_js = '\n'.join(c for _, c in modules)          # todo el JS embarcado
everything = src + '\n' + all_js                    # HTML + JS (para búsquedas cruzadas)

# ── 1. SINTAXIS JS (todos los módulos) ──────────────────────────────────────
print(f'\n{BOLD}[1] Sintaxis JS{RESET}')
tmp_js = os.path.join(ROOT, '.git', '_avi_audit.js')
try:
    with open(tmp_js, 'w', encoding='utf-8') as f:
        f.write(inline_js)
    bad = []
    for label, _ in modules:
        path = tmp_js if label == 'inline' else os.path.join(ROOT, label)
        result = subprocess.run(['node', '--check', path], capture_output=True, text=True)
        if result.returncode != 0:
            err_line = result.stderr.strip().split('\n')[0] if result.stderr else 'error desconocido'
            fail(f'Sintaxis JS inválida ({label}): {err_line}')
            bad.append(label)
    if not bad:
        ok(f'node --check pasó en {len(modules)} módulos (inline + {len(modules)-1} archivos)')
except FileNotFoundError:
    warn('node no encontrado — check de sintaxis saltado')
finally:
    if os.path.exists(tmp_js):
        os.remove(tmp_js)

# ── 2. FUNCIONES DUPLICADAS (dentro de y ENTRE módulos) ─────────────────────
print(f'\n{BOLD}[2] Funciones duplicadas{RESET}')
fn_where = {}
for label, content in modules:
    for fn in re.findall(r'^\s*(?:async\s+)?function (\w+)\s*\(', content, re.M):
        fn_where.setdefault(fn, []).append(label)
dupes = {k: v for k, v in fn_where.items() if len(v) > 1}
if dupes:
    det = ', '.join(f'{k} ({"+".join(v)})' for k, v in list(dupes.items())[:8])
    fail(f'Funciones duplicadas: {det}')
else:
    ok(f'{len(fn_where)} funciones en {len(modules)} módulos — sin duplicados')

# ── 3. IDs JS SIN MATCH ─────────────────────────────────────────────────────
# El HTML también se genera desde template literals en los módulos, así que un
# id vale si aparece declarado en CUALQUIER parte del código embarcado.
print(f'\n{BOLD}[3] IDs JS sin HTML{RESET}')
get_ids    = set(re.findall(r"getElementById\('([^']+)'\)", all_js))
static_ids = {i for i in get_ids if '${' not in i}
declared   = set(re.findall(r'id="([^"]+)"', everything))
in_src     = {i for i in static_ids if f'"{i}"' in everything or f"'{i}'" in everything.replace(f"getElementById('{i}')", '')}
missing    = static_ids - declared - in_src
# 🔴 APRETADO en v537 (auditoría de código): antes esto solo FALLABA con MÁS de 5 ids rotos; con
# 1 a 5 avisaba y **dejaba pasar el commit**. O sea que la ventana por la que se cuela un
# `getElementById` roto medía cinco, y un id roto no da error: devuelve null y la pantalla se queda
# a medias en silencio. El umbral existía por los ids que se ARMAN en tiempo de ejecución, pero de
# esos ya se encargan los dos filtros de arriba (`'${' not in i` y `in_src`).
# Medido al apretarlo: **0 ids rotos hoy** de 407 estáticos, así que el cambio no cuesta nada.
# Si algún día aparece uno legítimamente dinámico, va a `IDS_DINAMICOS` **con su razón al lado** —
# una excepción declarada se puede auditar; un umbral de 5 esconde las otras cuatro.
IDS_DINAMICOS = set()   # id → (vacío hoy). Añadir SOLO con el porqué escrito al lado.
missing = missing - IDS_DINAMICOS
if missing:
    fail(f'IDs JS sin HTML ({len(missing)}): {sorted(missing)[:8]}')
else:
    ok(f'{len(static_ids)} IDs estáticos — todos con match')

# ── 4. HANDLERS SIN FUNCIÓN ─────────────────────────────────────────────────
# Los onclick viven tanto en el HTML estático como en los templates JS.
print(f'\n{BOLD}[4] Handlers sin función{RESET}')
handlers = set(re.findall(r'on(?:click|input|change|submit)="(\w+)\(', everything))
exclude = {'cm', 'om', 'event', 'this', 'console', 'alert', 'confirm', 'if'}
fn_names  = set(re.findall(r'(?:async\s+)?function (\w+)\s*\(', all_js))
assigned  = set(re.findall(r'(?:const|let|var)\s+(\w+)\s*=\s*(?:async\s*)?(?:\(|\w+\s*=>)', all_js))
winprops  = set(re.findall(r'window\.(\w+)\s*=', all_js))
all_fns = fn_names | assigned | winprops | exclude
broken = sorted(h for h in handlers if h not in all_fns)
if broken:
    fail(f'Handlers sin función: {broken[:10]}')
else:
    ok(f'{len(handlers)} handlers — todos tienen función')

# ── 5. SB_KEYS COMPLETAS ────────────────────────────────────────────────────
print(f'\n{BOLD}[5] SB_KEYS sincronizadas{RESET}')
sb_match = re.search(r'const SB_KEYS\s*=\s*\[([^\]]+)\]', all_js)
required_keys = ['ax_c', 'ax_e', 'ax_hist', 'ax_pr', 'ax_bw',
                 'ax_nut', 'ax_med', 'ax_photos', 'ax_cph', 'ax_site']
if sb_match:
    sb_text = sb_match.group(1)
    missing_keys = [k for k in required_keys if k not in sb_text]
    if missing_keys:
        fail(f'SB_KEYS falta: {missing_keys}')
    else:
        ok(f'{len(required_keys)} claves críticas presentes en SB_KEYS')
else:
    fail('SB_KEYS no encontrado en el código')

# ── 6. EJERCICIOS DUPLICADOS ─────────────────────────────────────────────────
# Solo DEFINICIONES del catálogo (id + name juntos). Las referencias sueltas
# (entrenos rápidos, warmups: {id:'eN',sets...} sin name) son legítimas y
# repetibles. La integridad profunda la cubre audit-catalog (check 9).
print(f'\n{BOLD}[6] Ejercicios duplicados{RESET}')
ex_ids = re.findall(r"id:'(e\d+)',\s*name:", everything)
ex_dupes = {k: v for k, v in Counter(ex_ids).items() if v > 1}
if ex_dupes:
    fail(f'Ejercicios con ID duplicado: {ex_dupes}')
elif not ex_ids:
    fail('0 ejercicios encontrados — el patrón del catálogo cambió; actualiza el hook')
else:
    ok(f'{len(ex_ids)} ejercicios — sin IDs duplicados')

# ── 7. SECRETOS ACCIDENTALES (HTML + todos los módulos + sw.js) ─────────────
print(f'\n{BOLD}[7] Sin secretos en código{RESET}')
sw_path = os.path.join(ROOT, 'sw.js')
sw_js = open(sw_path, encoding='utf-8').read() if os.path.exists(sw_path) else ''
scan = everything + '\n' + sw_js
secret_patterns = [
    (r'VAPID_PRIVATE\s*=\s*["\'][^"\']{10}', 'VAPID_PRIVATE key en frontend'),
    (r'service_role\s*[=:]\s*["\'][^"\']{20}', 'Supabase service_role key'),
    (r'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9\.[A-Za-z0-9_-]{50,}', 'JWT token hardcodeado'),
    # 29-sep-2026: aquí vivía la contraseña VIEJA de la cuenta E2E escrita como patrón «a bloquear» —
    # o sea, publicada en el repo por el propio candado. Las credenciales conocidas las vigila ahora el
    # check [14] leyéndolas de ~/.avi, sin escribirlas nunca en este archivo.
]
secret_found = False
for pattern, label in secret_patterns:
    if re.search(pattern, scan):
        fail(f'Secreto detectado: {label}')
        secret_found = True
if not secret_found:
    ok('Sin secretos hardcodeados detectados')

# ── 8. TESTS DE NEGOCIO ──────────────────────────────────────────────────────
print(f'\n{BOLD}[8] Tests de negocio{RESET}')
test_file = os.path.join(ROOT, 'avi.test.js')
suite_count = None  # lo usa el check 11 (anti-borrado de tests)
if os.path.exists(test_file):
    result = subprocess.run(['node', test_file], capture_output=True,
                            encoding='utf-8', errors='replace', cwd=ROOT)
    stdout = (result.stdout or '').strip()
    m_cnt = re.search(r'AVI Tests: (\d+)/(\d+)', stdout)
    if m_cnt: suite_count = int(m_cnt.group(2))
    if result.returncode == 0:
        last = stdout.split('\n')[-1] if stdout else 'OK'
        ok(f'avi.test.js — {last.strip()}')
        # 🔴 Y OTRA VEZ EN UTC. CI corre en UTC y esta máquina en UTC-5, y esa diferencia
        # tapó un defecto REAL: `new Date(null)` es la época (1970-01-01 = Año Nuevo), así
        # que una fecha ausente se reportaba como FESTIVO — en Colombia la época cae el 31
        # de diciembre y daba false, o sea que el test correcto no podía fallar aquí. Lo
        # cazó CI cinco «Run failed» después. Correr la suite en los dos husos cuesta
        # segundos y cierra la clase entera, no solo este caso.
        env_utc = dict(os.environ, TZ='UTC')
        r_utc = subprocess.run(['node', test_file], capture_output=True,
                               encoding='utf-8', errors='replace', cwd=ROOT, env=env_utc)
        out_utc = (r_utc.stdout or '').strip()
        if r_utc.returncode == 0:
            ok('avi.test.js en UTC — ' + (out_utc.split('\n')[-1].strip() if out_utc else 'OK'))
        else:
            fail('Tests fallaron SOLO en UTC (así corre CI):\n' + '\n'.join(out_utc.split('\n')[-10:]))
        # 🔴 Y EN INGLÉS (v638). CI estuvo rojo desde v628 con todo verde aquí: un test esperaba
        # `(4320).toLocaleString()`, que aquí da «4.320» (Windows en es-CO) y en el runner «4,320».
        # En Windows Node no hace caso a LANG, así que se fuerza con una precarga.
        env_en = dict(os.environ, TZ='UTC', NODE_OPTIONS='--require ' + os.path.join(ROOT, 'scripts', 'hooks', '_idioma-en.cjs'))
        r_en = subprocess.run(['node', test_file], capture_output=True,
                              encoding='utf-8', errors='replace', cwd=ROOT, env=env_en)
        out_en = (r_en.stdout or '').strip()
        if r_en.returncode == 0:
            ok('avi.test.js en inglés + UTC — ' + (out_en.split('\n')[-1].strip() if out_en else 'OK'))
        else:
            fail('Tests fallaron SOLO en inglés (así corre CI):\n' + '\n'.join(out_en.split('\n')[-10:]))
        # 🔴 Y UNA TERCERA VEZ CON FINALES DE LÍNEA LF, que es lo que recibe CI.
        # Esta máquina tiene core.autocrlf=true: el repo guarda LF y la copia de trabajo es
        # CRLF, así que las dos corridas de arriba miden un archivo que NADIE MÁS TIENE.
        # Costó un CI en rojo (v594): un test extrae `buildWarmup` del archivo y ese trozo
        # TERMINA en una línea de comentario `//` — con CRLF el `\r` final hacía de
        # terminador y el `; return buildWarmup;` que se le concatena corría; con LF quedaba
        # DENTRO del comentario y la función salía undefined, con la suite verde aquí.
        # Los finales de línea de este repo no son estables (v537): la única forma de verlo
        # antes de empujar es correr la suite en LF.
        import tempfile, shutil
        LF_EXT = ('.js', '.mjs', '.cjs', '.html', '.css', '.json', '.sql', '.md')
        tmp_lf = tempfile.mkdtemp(prefix='avi-lf-')
        try:
            crudo = subprocess.run(['git', 'ls-files', '-z'],
                                   capture_output=True, cwd=ROOT).stdout or b''
            copiados = texto = convertidos = restos = 0
            for raw in crudo.split(b'\x00'):
                if not raw:
                    continue
                rel = raw.decode('utf-8').replace('/', os.sep)
                orig = os.path.join(ROOT, rel)
                if not os.path.isfile(orig):
                    continue
                dest = os.path.join(tmp_lf, rel)
                os.makedirs(os.path.dirname(dest), exist_ok=True)
                if rel.endswith(LF_EXT):
                    datos = open(orig, 'rb').read()
                    if b'\r\n' in datos:
                        datos = datos.replace(b'\r\n', b'\n')
                        convertidos += 1
                    open(dest, 'wb').write(datos)
                    texto += 1
                    if b'\r\n' in datos:
                        restos += 1
                else:
                    shutil.copyfile(orig, dest)
                copiados += 1
            # 🔒 CONTROL DE COBERTURA: se afirma la PROPIEDAD (el árbol quedó en LF), no
            #    cuántos se convirtieron. `convertidos == 0` es lo NORMAL en una máquina que
            #    ya trabaja en LF —CI, sin ir más lejos— y usarlo como control puso el propio
            #    CI en rojo la primera vez. Lo que invalida la corrida es no haber copiado el
            #    árbol o que quede un CRLF vivo: eso sí es no medir lo que se dice medir.
            if copiados < 20 or texto < 10 or restos:
                fail('La corrida en LF no montó lo que dice montar (%d archivos, %d de texto, '
                     '%d con CRLF vivo)' % (copiados, texto, restos))
            else:
                r_lf = subprocess.run(['node', os.path.join(tmp_lf, 'avi.test.js')],
                                      capture_output=True, encoding='utf-8',
                                      errors='replace', cwd=tmp_lf)
                out_lf = (r_lf.stdout or '').strip()
                if r_lf.returncode == 0:
                    ok('avi.test.js en LF (%d de texto, %d convertidos) — '
                       % (texto, convertidos) +
                       (out_lf.split('\n')[-1].strip() if out_lf else 'OK'))
                else:
                    fail('Tests fallaron SOLO con finales de línea LF (así los sirve el '
                         'checkout de CI):\n' + '\n'.join(out_lf.split('\n')[-10:]))
        finally:
            shutil.rmtree(tmp_lf, ignore_errors=True)
    else:
        tail = '\n'.join(stdout.split('\n')[-10:])
        fail(f'Tests fallaron:\n{tail}')
else:
    fail('avi.test.js no encontrado — la suite es obligatoria')

# ── 9. AUDITORÍA DE CATÁLOGO (integridad ejercicios/media/registros) ──────────
print(f'\n{BOLD}[9] Auditoría de catálogo{RESET}')
audit_file = os.path.join(ROOT, 'scripts', 'audit-catalog.mjs')
if os.path.exists(audit_file):
    result = subprocess.run(['node', audit_file], capture_output=True,
                            encoding='utf-8', errors='replace', cwd=ROOT)
    stdout = (result.stdout or '').strip()
    if result.returncode == 0:
        last = stdout.split('\n')[-1] if stdout else 'OK'
        ok(f'audit-catalog — {last.strip()}')
    else:
        fail(f'Auditoría de catálogo encontró errores BLOCK:\n{stdout}')
else:
    warn('scripts/audit-catalog.mjs no encontrado — auditoría saltada')

# ── 10. VERSIÓN COHERENTE (regla cache-bust: ?v=NNN de index.html = CACHE_NAME) ──
# Se desalineó 37 versiones en silencio (v244 vs v281, caught 2026-07-06).
print(f'\n{BOLD}[10] Versión ?v= vs CACHE_NAME{RESET}')
sw_src = sw_js  # ya leído en el check 7
m_sw = re.search(r"CACHE_NAME\s*=\s*'avi-v(\d+)'", sw_src)
vs = set(re.findall(r'\?v=(\d+)', src))
if not m_sw:
    fail('CACHE_NAME no encontrado en sw.js')
elif not vs:
    warn('index.html no usa ?v= — ¿se retiró el cache-bust? Actualiza este check')
elif len(vs) > 1:
    fail(f'index.html mezcla versiones ?v=: {sorted(vs)}')
elif vs != {m_sw.group(1)}:
    fail(f'Desalineados: index.html ?v={vs.pop()} vs sw.js avi-v{m_sw.group(1)} — bump ambos juntos')
else:
    ok(f'?v={m_sw.group(1)} coherente con CACHE_NAME avi-v{m_sw.group(1)}')

# ── 11. ANTI-BORRADO DE TESTS (baseline de la suite) ──────────────────────────
# El atajo clásico de un fix flojo es borrar el test que estorba. El conteo de la
# suite solo puede SUBIR; si baja, el commit se bloquea. Si el borrado fue deliberado
# (refactor aprobado por Camilo), actualiza scripts/hooks/suite-baseline en el mismo
# commit y deja el porqué en docs/bitacora.md.
print(f'\n{BOLD}[11] Baseline de la suite (anti-borrado de tests){RESET}')
baseline_file = os.path.join(ROOT, 'scripts', 'hooks', 'suite-baseline')
if suite_count is None:
    warn('No se pudo leer el conteo de la suite (¿falló el check 8?) — baseline sin comparar')
else:
    try:
        baseline = int(open(baseline_file, encoding='utf-8').read().strip())
    except Exception:
        baseline = None
    if baseline is None:
        with open(baseline_file, 'w', encoding='utf-8') as f: f.write(str(suite_count) + '\n')
        subprocess.run(['git', 'add', baseline_file], cwd=ROOT, capture_output=True)
        ok(f'Baseline creado: {suite_count} tests')
    elif suite_count < baseline:
        fail(f'La suite BAJÓ de {baseline} a {suite_count} tests — ¿se borró un test que estorbaba? '
             f'Si el borrado es legítimo, actualiza scripts/hooks/suite-baseline y documéntalo en la bitácora')
    elif suite_count > baseline:
        with open(baseline_file, 'w', encoding='utf-8') as f: f.write(str(suite_count) + '\n')
        subprocess.run(['git', 'add', baseline_file], cwd=ROOT, capture_output=True)
        ok(f'Suite creció {baseline} → {suite_count} — baseline actualizado y añadido al commit')
    else:
        ok(f'{suite_count} tests (= baseline)')

# ── 12. foods.json COINCIDE CON SU GENERADOR ──────────────────────────────────
# El catálogo de búsqueda del registro de alimentos es GENERADO (scripts/build-foods.mjs),
# no escrito a mano: si alguien lo edita directo, el próximo build le pisa el cambio en
# silencio. Y si se toca NUT_FOODS sin regenerar, el buscador sirve valores viejos.
print(f'\n{BOLD}[12] foods.json vs su generador{RESET}')
gen_foods = os.path.join(ROOT, 'scripts', 'build-foods.mjs')
if not os.path.exists(gen_foods):
    warn('scripts/build-foods.mjs no encontrado — check saltado')
elif not os.path.exists(os.path.join(ROOT, 'foods.json')):
    warn('foods.json no existe todavía — corre node scripts/build-foods.mjs')
else:
    r_f = subprocess.run(['node', gen_foods, '--check'], cwd=ROOT, capture_output=True, text=True)
    salida_f = (r_f.stdout or '') + (r_f.stderr or '')
    if r_f.returncode != 0:
        fail('foods.json está desfasado de scripts/build-foods.mjs — corre: node scripts/build-foods.mjs\n' + salida_f.strip())
    else:
        # Nada de matchear caracteres no-ASCII: la salida del subproceso llega con la
        # codificación de la consola de Windows y el '·' del reporte no sobrevive.
        m_nf = re.search(r'(\d+) alimentos', salida_f)
        m_rech = re.search(r'(\d+) alimento\(s\) RECHAZADO', salida_f)
        if m_rech:
            warn(f'{m_rech.group(1)} alimento(s) RECHAZADOS por el validador — no entran al '
                 f'catálogo. Corre: node scripts/build-foods.mjs para ver cuáles y por qué')
        ok(f'foods.json coincide con el generador ({m_nf.group(1) if m_nf else "?"} alimentos)')

# ── [13] Nombres reales de asesorados (el repo es PÚBLICO) ────────────────────────
# 29-sep-2026: el repo llevaba 4 meses con nombres completos, correos, pesos y la edad de un menor. Se
# seudonimizó todo y la tabla real ↔ seudónimo vive SOLO en ~/.avi/seudonimos.json. La lista de lo que no
# puede volver a entrar está en ~/.avi/nombres-reales.json — fuera del repo, porque la lista MISMA serían los
# nombres. Sin ese archivo (CI, otra máquina) el check se salta: es un candado LOCAL. Solo mira lo AÑADIDO.
print(f'\n{BOLD}[13] Nombres reales de asesorados{RESET}')
_lista_nr = os.path.join(os.path.expanduser('~'), '.avi', 'nombres-reales.json')
if not os.path.exists(_lista_nr):
    warn('~/.avi/nombres-reales.json no existe en esta máquina — check saltado')
else:
    try:
        with open(_lista_nr, encoding='utf-8') as _fh:
            _nr = json.load(_fh)
        _pats = [(p, re.compile(p)) for p in _nr.get('patrones', [])]
        _solo_agentes = set(_nr.get('permitidos_en_agentes', []))
        _diff = subprocess.run(['git', 'diff', '--cached', '-U0', '--no-color'], cwd=ROOT, capture_output=True,
                               text=True, encoding='utf-8', errors='replace').stdout
        _hallados = []; _arch = ''
        for _l in _diff.splitlines():
            if _l.startswith('+++ '):
                _arch = _l[6:] if _l.startswith('+++ b/') else ''
                continue
            if not _l.startswith('+') or not _arch:
                continue
            for _p, _rx in _pats:
                if _arch.startswith('.claude/agents/') and _p in _solo_agentes:
                    continue
                if _rx.search(_l[1:]):
                    _hallados.append(f'{_arch}: «{_rx.search(_l[1:]).group(0)}»')
        if _hallados:
            fail('Nombre o correo REAL de un asesorado en lo que vas a subir (el repo es público). Usa su seudónimo '
                 '(~/.avi/seudonimos.json):\n    ' + '\n    '.join(sorted(set(_hallados))[:15]))
        else:
            ok(f'ningún nombre ni correo real en lo añadido ({len(_pats)} patrones)')
    except Exception as _e:
        fail(f'no pude leer ~/.avi/nombres-reales.json: {_e}')

# ── [13b] Teléfonos y uid REALES (v694, R17 A2) ─────────────────────────────────────
# A v690 se le escaparon un TELÉFONO real y 4 uid de cuentas reales (2 de menores) en informes viejos de
# docs/. La fuente es el respaldo diario más nuevo (Desktop/AVI/backups, FUERA del repo): los teléfonos de
# las fichas (sus 10 dígitos, contra los dígitos de cada línea añadida) y los uid de las cuentas (completos
# o sus primeros 8 caracteres, como los cita un informe), salvo el del coach (el código lo necesita) y los
# QA. Sin respaldo en esta máquina (CI), se salta: es un candado LOCAL, como el de los nombres.
print(f'\n{BOLD}[13b] Teléfonos y uid reales{RESET}')
_bk_dir = os.path.join(os.path.expanduser('~'), 'Desktop', 'AVI', 'backups')
_bks = sorted(f for f in (os.listdir(_bk_dir) if os.path.isdir(_bk_dir) else [])
              if re.match(r'^avi-backup-\d{4}-\d{2}-\d{2}\.json$', f))
if not _bks:
    warn('sin respaldo local en Desktop/AVI/backups — check de teléfonos y uid saltado')
else:
    try:
        with open(os.path.join(_bk_dir, _bks[-1]), encoding='utf-8') as _fh:
            _bk = json.load(_fh)
        _COACH_UID = '0a6484ed-42af-449d-9903-e440ac683ecf'
        _tels = set()
        for _r in _bk.get('user_data', []) or []:
            _t = re.sub(r'\D', '', str((((_r or {}).get('profile')) or {}).get('phone') or ''))[-10:]
            if len(_t) == 10:
                _tels.add(_t)
        _uids = set()
        for _u in _bk.get('auth_users', []) or []:
            _id = str((_u or {}).get('id') or '').lower()
            if _id and _id != _COACH_UID and 'qa' not in str((_u or {}).get('email') or '').lower():
                _uids.add(_id)
                _uids.add(_id[:8])
        _rx_uid = [re.compile(r'(?<![0-9a-f])' + re.escape(_u) + r'(?![0-9a-f])') for _u in sorted(_uids)]
        _diff2 = subprocess.run(['git', 'diff', '--cached', '-U0', '--no-color'], cwd=ROOT, capture_output=True,
                                text=True, encoding='utf-8', errors='replace').stdout
        _h2 = []; _arch = ''
        for _l in _diff2.splitlines():
            if _l.startswith('+++ '):
                _arch = _l[6:] if _l.startswith('+++ b/') else ''
                continue
            if not _l.startswith('+') or not _arch:
                continue
            _txt = _l[1:]
            _dig = re.sub(r'\D', '', _txt)
            if any(_t in _dig for _t in _tels):
                _h2.append(f'{_arch}: un TELÉFONO real')
            _low = _txt.lower()
            if any(_rx.search(_low) for _rx in _rx_uid):
                _h2.append(f'{_arch}: un uid de una cuenta real')
        if _h2:
            fail('Dato REAL de un asesorado en lo que vas a subir (el repo es público). Quítalo o cámbialo por '
                 '«(teléfono oculto)» / «(uid de un asesorado)»:\n    ' + '\n    '.join(sorted(set(_h2))[:15]))
        else:
            ok(f'ningún teléfono ni uid real en lo añadido ({len(_tels)} teléfonos y {len(_uids) // 2} cuentas del respaldo {_bks[-1][11:21]})')
    except Exception as _e:
        fail(f'no pude leer el respaldo {_bks[-1]}: {_e}')

# ── [14] Credenciales en lo añadido (el repo es PÚBLICO) ─────────────────────────
# 29-sep-2026, alerta de GitGuardian: un script de R16 traía en claro la contraseña del coach QA junto a su
# correo, y el check [7] no la vio porque solo busca LLAVES (JWT, service_role, VAPID). Peor: el propio [7]
# llevaba desde el 6-jul la contraseña vieja de una cuenta REAL escrita como patrón a bloquear. Dos vías:
#  (a) LOCAL — todo secreto que vive en ~/.avi (campos «pass*» de sus .json, líneas «pass:» de
#      qa-accounts.txt, archivos .key) se busca LITERAL en lo añadido. El valor se lee, jamás se escribe aquí.
#  (b) EN TODAS PARTES — una contraseña literal asignada en el código (una clave «pass» o «password» seguida de un texto entre comillas).
#      Un literal que se CONCATENA no cuenta (así se arman las claves desechables de _verify-borrado-*).
#      Las excepciones se DECLARAN una por una con su razón (lección v537: un umbral esconde, una lista se audita).
print(f'\n{BOLD}[14] Credenciales en lo añadido{RESET}')
FIXTURES_OK = {
    'Clave123',  # avi.test.js — validateSignup: contraseña de ejemplo que cumple la política; no abre nada
    'corta1',    # avi.test.js — validateSignup: el caso que la política RECHAZA
}
_rx_pass = re.compile(r'''(?i)(?:pass(?:word|wd)?|contrase[ñn]a|clave)["']?\s*[:=]\s*["'`]([^"'`\s$]{6,})["'`](?!\s*\+)''')
_secretos = []
_avi = os.path.join(os.path.expanduser('~'), '.avi')
if os.path.isdir(_avi):
    for _f in os.listdir(_avi):
        _p = os.path.join(_avi, _f)
        if not os.path.isfile(_p):
            continue
        try:
            if _f.endswith('.json'):
                with open(_p, encoding='utf-8') as _fh:
                    _j = json.load(_fh)
                _pila = [_j]
                while _pila:
                    _o = _pila.pop()
                    if isinstance(_o, dict):
                        for _k, _v in _o.items():
                            if isinstance(_v, str) and re.search(r'(?i)pass', _k):
                                _secretos.append(_v)
                            elif isinstance(_v, (dict, list)):
                                _pila.append(_v)
                    elif isinstance(_o, list):
                        _pila.extend(_o)
            elif _f == 'qa-accounts.txt':
                with open(_p, encoding='utf-8') as _fh:
                    _secretos += re.findall(r'pass:\s*(\S+)', _fh.read())
            elif _f.endswith('.key'):
                with open(_p, encoding='utf-8') as _fh:
                    _secretos.append(_fh.read().strip())
        except Exception:
            pass
_secretos = sorted({s for s in _secretos if len(s) >= 6})
_diff14 = subprocess.run(['git', 'diff', '--cached', '-U0', '--no-color'], cwd=ROOT, capture_output=True,
                         text=True, encoding='utf-8', errors='replace').stdout
_cred = []; _arch = ''
for _l in _diff14.splitlines():
    if _l.startswith('+++ '):
        _arch = _l[6:] if _l.startswith('+++ b/') else ''
        continue
    if not _l.startswith('+') or not _arch:
        continue
    _t = _l[1:]
    if any(_s in _t for _s in _secretos):
        _cred.append(f'{_arch}: un secreto de ~/.avi escrito tal cual')
    for _m in _rx_pass.finditer(_t):
        if _m.group(1) not in FIXTURES_OK:
            _cred.append(f'{_arch}: contraseña literal asignada a «{_t[max(0, _m.start() - 12):_m.start(1)].strip()}…»')
if _cred:
    fail('Credencial en lo que vas a subir (el repo es público; léela de ~/.avi como _verify-rls-aislamiento):\n    '
         + '\n    '.join(sorted(set(_cred))[:15]))
elif not _secretos:
    warn(f'~/.avi sin secretos legibles en esta máquina — solo corrió la vía genérica')
else:
    ok(f'ninguna credencial en lo añadido ({len(_secretos)} secretos de ~/.avi + patrón genérico)')

# ── RESUMEN ───────────────────────────────────────────────────────────────────
total = 14
failed = len(errors)
warned = len(warnings)

print(f'\n{BOLD}━━━ Resultado ━━━{RESET}')
print(f'  Checks: {total - failed}/{total} OK  |  {failed} errores  |  {warned} avisos')

if errors:
    print(f'\n{RED}{BOLD}🔴 COMMIT ABORTADO — corrige los errores antes de deployar{RESET}')
    print(f'{YELLOW}   (Para emergencias extremas: git commit --no-verify){RESET}\n')
    sys.exit(1)
elif warnings:
    print(f'\n{YELLOW}🟡 Commit permitido — revisa los avisos pronto{RESET}\n')
    sys.exit(0)
else:
    print(f'\n{GREEN}{BOLD}🟢 Audit OK — commit autorizado{RESET}\n')
    sys.exit(0)
