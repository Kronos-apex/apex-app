#!/usr/bin/env python3
# AVI pre-commit hook — aborta el commit si la auditoría falla.
# Para saltarlo intencionalmente: git commit --no-verify (solo emergencias)
#
# ESTE es el hook VIVO: core.hooksPath=scripts/hooks (así la copia versionada
# y la activa son EL MISMO archivo; antes .git/hooks divergía en silencio).
# Reescrito 2026-07-06: el hook viejo auditaba el <script> inline de index.html
# y apex-core.js/apex.test.js — todo pre-modularización y pre-rename. Desde
# entonces el JS vive en avi-core.js + app-1..6 + muscle-map + exercise-muscles,
# y encima core.hooksPath apuntaba a Desktop\apex (ruta muerta) → NINGÚN commit
# corría el audit. Ahora audita los módulos reales.

import re, subprocess, sys, os, io
from collections import Counter

sys.stdout = io.TextIOWrapper(sys.stdout.buffer, encoding='utf-8', errors='replace')
sys.stderr = io.TextIOWrapper(sys.stderr.buffer, encoding='utf-8', errors='replace')

ROOT = os.path.dirname(os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
INDEX = os.path.join(ROOT, 'index.html')

# Todos los módulos JS que embarca la app (el orden refleja index.html).
APP_JS = ['avi-core.js', 'muscle-map.js', 'exercise-muscles.js', 'app-1-infra.js',
          'app-2-login.js', 'app-3-coach.js', 'app-4-entreno.js', 'app-5-salud.js',
          'app-6-extra.js', 'app-7-community.js']

RED   = '\033[91m'
GREEN = '\033[92m'
YELLOW= '\033[93m'
RESET = '\033[0m'
BOLD  = '\033[1m'

errors = []
warnings = []

def ok(msg):    print(f'  {GREEN}✅{RESET} {msg}')
def fail(msg):  errors.append(msg);  print(f'  {RED}❌{RESET} {msg}')
def warn(msg):  warnings.append(msg);print(f'  {YELLOW}⚠️ {RESET} {msg}')

print(f'\n{BOLD}━━━ AVI pre-commit audit ━━━{RESET}')

if not os.path.exists(INDEX):
    print(f'{YELLOW}⚠️  index.html no encontrado — audit saltado{RESET}\n')
    sys.exit(0)

with open(INDEX, encoding='utf-8') as f:
    src = f.read()

# JS inline de index.html (queda poco, pero sigue siendo código embarcado).
script_start = src.find('<script>')
script_end   = src.find('</script>', script_start)
inline_js  = src[script_start + 8 : script_end] if script_start != -1 else ''

# (etiqueta, contenido) de cada módulo presente.
modules = [('inline', inline_js)]
for name in APP_JS:
    p = os.path.join(ROOT, name)
    if os.path.exists(p):
        with open(p, encoding='utf-8') as f:
            modules.append((name, f.read()))
    else:
        warn(f'{name} no existe — ¿se renombró? Actualiza APP_JS en scripts/hooks/pre-commit')

all_js = '\n'.join(c for _, c in modules)          # todo el JS embarcado
everything = src + '\n' + all_js                    # HTML + JS (para búsquedas cruzadas)

# ── 1. SINTAXIS JS (todos los módulos) ──────────────────────────────────────
print(f'\n{BOLD}[1] Sintaxis JS{RESET}')
tmp_js = os.path.join(ROOT, '.git', '_avi_audit.js')
try:
    with open(tmp_js, 'w', encoding='utf-8') as f:
        f.write(inline_js)
    bad = []
    for label, _ in modules:
        path = tmp_js if label == 'inline' else os.path.join(ROOT, label)
        result = subprocess.run(['node', '--check', path], capture_output=True, text=True)
        if result.returncode != 0:
            err_line = result.stderr.strip().split('\n')[0] if result.stderr else 'error desconocido'
            fail(f'Sintaxis JS inválida ({label}): {err_line}')
            bad.append(label)
    if not bad:
        ok(f'node --check pasó en {len(modules)} módulos (inline + {len(modules)-1} archivos)')
except FileNotFoundError:
    warn('node no encontrado — check de sintaxis saltado')
finally:
    if os.path.exists(tmp_js):
        os.remove(tmp_js)

# ── 2. FUNCIONES DUPLICADAS (dentro de y ENTRE módulos) ─────────────────────
print(f'\n{BOLD}[2] Funciones duplicadas{RESET}')
fn_where = {}
for label, content in modules:
    for fn in re.findall(r'^\s*(?:async\s+)?function (\w+)\s*\(', content, re.M):
        fn_where.setdefault(fn, []).append(label)
dupes = {k: v for k, v in fn_where.items() if len(v) > 1}
if dupes:
    det = ', '.join(f'{k} ({"+".join(v)})' for k, v in list(dupes.items())[:8])
    fail(f'Funciones duplicadas: {det}')
else:
    ok(f'{len(fn_where)} funciones en {len(modules)} módulos — sin duplicados')

# ── 3. IDs JS SIN MATCH ─────────────────────────────────────────────────────
# El HTML también se genera desde template literals en los módulos, así que un
# id vale si aparece declarado en CUALQUIER parte del código embarcado.
print(f'\n{BOLD}[3] IDs JS sin HTML{RESET}')
get_ids    = set(re.findall(r"getElementById\('([^']+)'\)", all_js))
static_ids = {i for i in get_ids if '${' not in i}
declared   = set(re.findall(r'id="([^"]+)"', everything))
in_src     = {i for i in static_ids if f'"{i}"' in everything or f"'{i}'" in everything.replace(f"getElementById('{i}')", '')}
missing    = static_ids - declared - in_src
if missing:
    if len(missing) > 5:
        fail(f'IDs JS sin HTML: {sorted(missing)[:8]}')
    else:
        warn(f'IDs posiblemente dinámicos: {sorted(missing)}')
else:
    ok(f'{len(static_ids)} IDs estáticos — todos con match')

# ── 4. HANDLERS SIN FUNCIÓN ─────────────────────────────────────────────────
# Los onclick viven tanto en el HTML estático como en los templates JS.
print(f'\n{BOLD}[4] Handlers sin función{RESET}')
handlers = set(re.findall(r'on(?:click|input|change|submit)="(\w+)\(', everything))
exclude = {'cm', 'om', 'event', 'this', 'console', 'alert', 'confirm', 'if'}
fn_names  = set(re.findall(r'(?:async\s+)?function (\w+)\s*\(', all_js))
assigned  = set(re.findall(r'(?:const|let|var)\s+(\w+)\s*=\s*(?:async\s*)?(?:\(|\w+\s*=>)', all_js))
winprops  = set(re.findall(r'window\.(\w+)\s*=', all_js))
all_fns = fn_names | assigned | winprops | exclude
broken = sorted(h for h in handlers if h not in all_fns)
if broken:
    fail(f'Handlers sin función: {broken[:10]}')
else:
    ok(f'{len(handlers)} handlers — todos tienen función')

# ── 5. SB_KEYS COMPLETAS ────────────────────────────────────────────────────
print(f'\n{BOLD}[5] SB_KEYS sincronizadas{RESET}')
sb_match = re.search(r'const SB_KEYS\s*=\s*\[([^\]]+)\]', all_js)
required_keys = ['ax_c', 'ax_e', 'ax_hist', 'ax_pr', 'ax_bw',
                 'ax_nut', 'ax_med', 'ax_photos', 'ax_cph', 'ax_site']
if sb_match:
    sb_text = sb_match.group(1)
    missing_keys = [k for k in required_keys if k not in sb_text]
    if missing_keys:
        fail(f'SB_KEYS falta: {missing_keys}')
    else:
        ok(f'{len(required_keys)} claves críticas presentes en SB_KEYS')
else:
    fail('SB_KEYS no encontrado en el código')

# ── 6. EJERCICIOS DUPLICADOS ─────────────────────────────────────────────────
# Solo DEFINICIONES del catálogo (id + name juntos). Las referencias sueltas
# (entrenos rápidos, warmups: {id:'eN',sets...} sin name) son legítimas y
# repetibles. La integridad profunda la cubre audit-catalog (check 9).
print(f'\n{BOLD}[6] Ejercicios duplicados{RESET}')
ex_ids = re.findall(r"id:'(e\d+)',\s*name:", everything)
ex_dupes = {k: v for k, v in Counter(ex_ids).items() if v > 1}
if ex_dupes:
    fail(f'Ejercicios con ID duplicado: {ex_dupes}')
elif not ex_ids:
    fail('0 ejercicios encontrados — el patrón del catálogo cambió; actualiza el hook')
else:
    ok(f'{len(ex_ids)} ejercicios — sin IDs duplicados')

# ── 7. SECRETOS ACCIDENTALES (HTML + todos los módulos + sw.js) ─────────────
print(f'\n{BOLD}[7] Sin secretos en código{RESET}')
sw_path = os.path.join(ROOT, 'sw.js')
sw_js = open(sw_path, encoding='utf-8').read() if os.path.exists(sw_path) else ''
scan = everything + '\n' + sw_js
secret_patterns = [
    (r'VAPID_PRIVATE\s*=\s*["\'][^"\']{10}', 'VAPID_PRIVATE key en frontend'),
    (r'service_role\s*[=:]\s*["\'][^"\']{20}', 'Supabase service_role key'),
    (r'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9\.[A-Za-z0-9_-]{50,}', 'JWT token hardcodeado'),
    (r'Samuel2026|samuel@apex\.com', 'credenciales de la cuenta de prueba E2E'),
]
secret_found = False
for pattern, label in secret_patterns:
    if re.search(pattern, scan):
        fail(f'Secreto detectado: {label}')
        secret_found = True
if not secret_found:
    ok('Sin secretos hardcodeados detectados')

# ── 8. TESTS DE NEGOCIO ──────────────────────────────────────────────────────
print(f'\n{BOLD}[8] Tests de negocio{RESET}')
test_file = os.path.join(ROOT, 'avi.test.js')
suite_count = None  # lo usa el check 11 (anti-borrado de tests)
if os.path.exists(test_file):
    result = subprocess.run(['node', test_file], capture_output=True,
                            encoding='utf-8', errors='replace', cwd=ROOT)
    stdout = (result.stdout or '').strip()
    m_cnt = re.search(r'AVI Tests: (\d+)/(\d+)', stdout)
    if m_cnt: suite_count = int(m_cnt.group(2))
    if result.returncode == 0:
        last = stdout.split('\n')[-1] if stdout else 'OK'
        ok(f'avi.test.js — {last.strip()}')
        # 🔴 Y OTRA VEZ EN UTC. CI corre en UTC y esta máquina en UTC-5, y esa diferencia
        # tapó un defecto REAL: `new Date(null)` es la época (1970-01-01 = Año Nuevo), así
        # que una fecha ausente se reportaba como FESTIVO — en Colombia la época cae el 31
        # de diciembre y daba false, o sea que el test correcto no podía fallar aquí. Lo
        # cazó CI cinco «Run failed» después. Correr la suite en los dos husos cuesta
        # segundos y cierra la clase entera, no solo este caso.
        env_utc = dict(os.environ, TZ='UTC')
        r_utc = subprocess.run(['node', test_file], capture_output=True,
                               encoding='utf-8', errors='replace', cwd=ROOT, env=env_utc)
        out_utc = (r_utc.stdout or '').strip()
        if r_utc.returncode == 0:
            ok('avi.test.js en UTC — ' + (out_utc.split('\n')[-1].strip() if out_utc else 'OK'))
        else:
            fail('Tests fallaron SOLO en UTC (así corre CI):\n' + '\n'.join(out_utc.split('\n')[-10:]))
    else:
        tail = '\n'.join(stdout.split('\n')[-10:])
        fail(f'Tests fallaron:\n{tail}')
else:
    fail('avi.test.js no encontrado — la suite es obligatoria')

# ── 9. AUDITORÍA DE CATÁLOGO (integridad ejercicios/media/registros) ──────────
print(f'\n{BOLD}[9] Auditoría de catálogo{RESET}')
audit_file = os.path.join(ROOT, 'scripts', 'audit-catalog.mjs')
if os.path.exists(audit_file):
    result = subprocess.run(['node', audit_file], capture_output=True,
                            encoding='utf-8', errors='replace', cwd=ROOT)
    stdout = (result.stdout or '').strip()
    if result.returncode == 0:
        last = stdout.split('\n')[-1] if stdout else 'OK'
        ok(f'audit-catalog — {last.strip()}')
    else:
        fail(f'Auditoría de catálogo encontró errores BLOCK:\n{stdout}')
else:
    warn('scripts/audit-catalog.mjs no encontrado — auditoría saltada')

# ── 10. VERSIÓN COHERENTE (regla cache-bust: ?v=NNN de index.html = CACHE_NAME) ──
# Se desalineó 37 versiones en silencio (v244 vs v281, caught 2026-07-06).
print(f'\n{BOLD}[10] Versión ?v= vs CACHE_NAME{RESET}')
sw_src = sw_js  # ya leído en el check 7
m_sw = re.search(r"CACHE_NAME\s*=\s*'avi-v(\d+)'", sw_src)
vs = set(re.findall(r'\?v=(\d+)', src))
if not m_sw:
    fail('CACHE_NAME no encontrado en sw.js')
elif not vs:
    warn('index.html no usa ?v= — ¿se retiró el cache-bust? Actualiza este check')
elif len(vs) > 1:
    fail(f'index.html mezcla versiones ?v=: {sorted(vs)}')
elif vs != {m_sw.group(1)}:
    fail(f'Desalineados: index.html ?v={vs.pop()} vs sw.js avi-v{m_sw.group(1)} — bump ambos juntos')
else:
    ok(f'?v={m_sw.group(1)} coherente con CACHE_NAME avi-v{m_sw.group(1)}')

# ── 11. ANTI-BORRADO DE TESTS (baseline de la suite) ──────────────────────────
# El atajo clásico de un fix flojo es borrar el test que estorba. El conteo de la
# suite solo puede SUBIR; si baja, el commit se bloquea. Si el borrado fue deliberado
# (refactor aprobado por Camilo), actualiza scripts/hooks/suite-baseline en el mismo
# commit y deja el porqué en docs/bitacora.md.
print(f'\n{BOLD}[11] Baseline de la suite (anti-borrado de tests){RESET}')
baseline_file = os.path.join(ROOT, 'scripts', 'hooks', 'suite-baseline')
if suite_count is None:
    warn('No se pudo leer el conteo de la suite (¿falló el check 8?) — baseline sin comparar')
else:
    try:
        baseline = int(open(baseline_file, encoding='utf-8').read().strip())
    except Exception:
        baseline = None
    if baseline is None:
        with open(baseline_file, 'w', encoding='utf-8') as f: f.write(str(suite_count) + '\n')
        subprocess.run(['git', 'add', baseline_file], cwd=ROOT, capture_output=True)
        ok(f'Baseline creado: {suite_count} tests')
    elif suite_count < baseline:
        fail(f'La suite BAJÓ de {baseline} a {suite_count} tests — ¿se borró un test que estorbaba? '
             f'Si el borrado es legítimo, actualiza scripts/hooks/suite-baseline y documéntalo en la bitácora')
    elif suite_count > baseline:
        with open(baseline_file, 'w', encoding='utf-8') as f: f.write(str(suite_count) + '\n')
        subprocess.run(['git', 'add', baseline_file], cwd=ROOT, capture_output=True)
        ok(f'Suite creció {baseline} → {suite_count} — baseline actualizado y añadido al commit')
    else:
        ok(f'{suite_count} tests (= baseline)')

# ── 12. foods.json COINCIDE CON SU GENERADOR ──────────────────────────────────
# El catálogo de búsqueda del registro de alimentos es GENERADO (scripts/build-foods.mjs),
# no escrito a mano: si alguien lo edita directo, el próximo build le pisa el cambio en
# silencio. Y si se toca NUT_FOODS sin regenerar, el buscador sirve valores viejos.
print(f'\n{BOLD}[12] foods.json vs su generador{RESET}')
gen_foods = os.path.join(ROOT, 'scripts', 'build-foods.mjs')
if not os.path.exists(gen_foods):
    warn('scripts/build-foods.mjs no encontrado — check saltado')
elif not os.path.exists(os.path.join(ROOT, 'foods.json')):
    warn('foods.json no existe todavía — corre node scripts/build-foods.mjs')
else:
    r_f = subprocess.run(['node', gen_foods, '--check'], cwd=ROOT, capture_output=True, text=True)
    salida_f = (r_f.stdout or '') + (r_f.stderr or '')
    if r_f.returncode != 0:
        fail('foods.json está desfasado de scripts/build-foods.mjs — corre: node scripts/build-foods.mjs\n' + salida_f.strip())
    else:
        # Nada de matchear caracteres no-ASCII: la salida del subproceso llega con la
        # codificación de la consola de Windows y el '·' del reporte no sobrevive.
        m_nf = re.search(r'(\d+) alimentos', salida_f)
        m_rech = re.search(r'(\d+) alimento\(s\) RECHAZADO', salida_f)
        if m_rech:
            warn(f'{m_rech.group(1)} alimento(s) RECHAZADOS por el validador — no entran al '
                 f'catálogo. Corre: node scripts/build-foods.mjs para ver cuáles y por qué')
        ok(f'foods.json coincide con el generador ({m_nf.group(1) if m_nf else "?"} alimentos)')

# ── RESUMEN ───────────────────────────────────────────────────────────────────
total = 12
failed = len(errors)
warned = len(warnings)

print(f'\n{BOLD}━━━ Resultado ━━━{RESET}')
print(f'  Checks: {total - failed}/{total} OK  |  {failed} errores  |  {warned} avisos')

if errors:
    print(f'\n{RED}{BOLD}🔴 COMMIT ABORTADO — corrige los errores antes de deployar{RESET}')
    print(f'{YELLOW}   (Para emergencias extremas: git commit --no-verify){RESET}\n')
    sys.exit(1)
elif warnings:
    print(f'\n{YELLOW}🟡 Commit permitido — revisa los avisos pronto{RESET}\n')
    sys.exit(0)
else:
    print(f'\n{GREEN}{BOLD}🟢 Audit OK — commit autorizado{RESET}\n')
    sys.exit(0)
